# ---- dependencies ----
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ---- build output ----
# Copied from node_modules by scripts/copy-map-worker.mjs. Generated, not
# authored: committing it would let a 500KB artifact drift from its library.
public/maplibre/
.next/
out/
build/
dist/
next-env.d.ts

# ---- environment & secrets ----
# Never commit real credentials. Only .env.example is tracked.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/
.vapid.json

# ---- test & coverage output ----
coverage/
test-results/
playwright-report/
blob-report/
.playwright/
playwright/.cache/
.vitest-cache/

# ---- caches & tooling ----
.eslintcache
.cache/
.turbo/
*.tsbuildinfo
.vercel/

# ---- local Claude Code state ----
# Shared project config (.claude/settings.json, .claude/agents, .claude/skills) IS
# tracked, so the design-engineering tooling comes with a clone.
.claude/settings.local.json
.claude/state/
.claude/logs/

# The Impeccable engine is a 16MB platform-specific binary that the launcher
# downloads on first run. It is regenerable (`npx impeccable install`) and
# would only ever be correct for whoever committed it.
.claude/skills/impeccable/scripts/bin/

# Where Playwright MCP writes screenshots and traces during a design pass.
.playwright-mcp/

# ---- editors & OS ----
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.DS_Store
Thumbs.db
desktop.ini
*.swp

# ---- logs ----
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---- geo build cache ----
# Natural Earth downloads, re-fetched by scripts/build-geo.mjs when absent.
.geo-cache/

# ---- airport reference build cache ----
# OurAirports download, re-fetched by scripts/build-airports.mjs when absent.
.airports-cache/
