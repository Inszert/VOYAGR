# ---------------------------------------------------------------------------
# Voyagr — environment template
#
# Copy to `.env.local` and fill in real values locally:
#     cp .env.example .env.local
#
# `.env.local` is gitignored. NEVER commit real credentials to this file.
# Every value below is an inert placeholder.
#
# Variables are validated at startup by `src/lib/env.ts`. Anything left unset
# simply disables the corresponding capability — the app still boots and the
# test suite still passes with this file's defaults.
# ---------------------------------------------------------------------------

# ---- Core application ----------------------------------------------------
# development | test | production
NODE_ENV=development
# Public origin used for absolute URLs, manifest and Web Push payload links.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Comma-separated log level: fatal|error|warn|info|debug|trace
LOG_LEVEL=info

# ---- Persistence (PostgreSQL) --------------------------------------------
# Optional for the foundation. When unset, the in-memory repositories are used
# and no database connection is ever opened.
# Example shape only — not a real host:
# DATABASE_URL=postgresql://voyagr:CHANGE_ME@localhost:5432/voyagr
DATABASE_URL=
# Set to "true" to require TLS for the database connection (recommended in prod).
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# ---- Background jobs (Redis + BullMQ) ------------------------------------
# Optional for the foundation. When unset, the in-process memory queue driver is
# used, so Travel Watch jobs can be developed without running Redis.
# REDIS_URL=redis://localhost:6379
REDIS_URL=
# memory | bullmq   (bullmq requires REDIS_URL)
QUEUE_DRIVER=memory

# ---- AI provider ----------------------------------------------------------
# The application talks to an internal AI abstraction, never to a vendor SDK
# directly. `mock` is deterministic and requires no credentials.
# mock | anthropic
AI_PROVIDER=mock
AI_MODEL=claude-sonnet-5
# Only read when AI_PROVIDER is a real vendor. Leave blank for mock.
ANTHROPIC_API_KEY=

# ---- Travel provider adapters --------------------------------------------
# Each adapter selects an implementation. `mock` serves deterministic fixtures
# and needs no credentials or network access.
FLIGHT_PROVIDER=mock
HOTEL_PROVIDER=mock
WEATHER_PROVIDER=mock
TRANSFER_PROVIDER=mock
PLACES_PROVIDER=mock

# Credentials for real adapters. Leave blank until a provider is contracted.
FLIGHT_PROVIDER_API_KEY=
HOTEL_PROVIDER_API_KEY=
WEATHER_PROVIDER_API_KEY=
TRANSFER_PROVIDER_API_KEY=
PLACES_PROVIDER_API_KEY=

# ---- Web Push notifications ----------------------------------------------
# Generate a throwaway local keypair with: npx web-push generate-vapid-keys
# The private key is a secret; the public key is safe to expose to the browser.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:dev@example.invalid
